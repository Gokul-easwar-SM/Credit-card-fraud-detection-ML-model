# Copy to .env and fill in. NEVER commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# PostgreSQL (used by docker compose)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=
POSTGRES_DB=fraud
# Only when running the backend outside Docker:
# Postgres: DATABASE_URL=postgresql+psycopg://fraud:<password>@localhost:5432/fraud
# SQLite fallback: DATABASE_URL=sqlite:///./dev.db
